PORT=3000

# Postgres connection. Run `docker compose up -d db` to start the database, then point
# DATABASE_URL at its published localhost port. POSTGRES_USER/PASSWORD/DB also configure the
# `db` service itself in docker-compose.yml — these are non-secret local-dev defaults, not
# production credentials.
DATABASE_URL="postgresql://library:library@localhost:5432/library"
POSTGRES_USER="library"
POSTGRES_PASSWORD="library"
POSTGRES_DB="library"

JWT_SECRET="change-me-to-a-long-random-string"
# Access token lifetime (short-lived). Falls back to JWT_EXPIRES_IN for backward compat.
JWT_ACCESS_EXPIRES_IN="1h"
# Refresh token lifetimes. rememberMe=false uses JWT_REFRESH_EXPIRES_IN, rememberMe=true uses
# JWT_REFRESH_EXPIRES_IN_REMEMBER.
JWT_REFRESH_EXPIRES_IN="2h"
JWT_REFRESH_EXPIRES_IN_REMEMBER="30d"
# Kept for backward compatibility — used as fallback if JWT_ACCESS_EXPIRES_IN is unset.
JWT_EXPIRES_IN="1h"
CORS_ORIGIN="http://localhost:5173"

# 32-byte key (base64) that encrypts TOTP secrets at rest (src/lib/secretBox.js). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it out of the database and out of git; losing it makes every enrolled MFA secret unreadable.
MFA_ENCRYPTION_KEY="replace-with-32-random-bytes-base64"

# Seeded by prisma/seed.js. These are intentionally the well-known demo
# credentials documented in documents/backend-api-specification.md (Section
# 6.1) — override them if you want a different demo account, but do not put
# real user credentials here.
DEMO_USER_USERNAME="demo.user"
DEMO_USER_PASSWORD="demo.user"
DEMO_USER_FULL_NAME="Demo Reader"
DEMO_USER_ROLE="reader"

# Optional admin user seeded by prisma/seed.js. If ADMIN_USER_USERNAME is set,
# ADMIN_USER_PASSWORD and ADMIN_USER_FULL_NAME are also required. The role is
# always fixed to "admin" — no ADMIN_USER_ROLE variable.
# ADMIN_USER_USERNAME="admin"
# ADMIN_USER_PASSWORD="change-me"
# ADMIN_USER_FULL_NAME="Admin"
